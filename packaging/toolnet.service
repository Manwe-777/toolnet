# toolnet as a system service. Install or update with packaging/install.sh:
#
#   sudo packaging/install.sh target/release/toolnet --state-from <dir> \
#        --args "--exit-node homelab"
#
# Flags for `toolnet up` live in a drop-in (toolnet.service.d/args.conf), the
# user allowed to connect / disconnect / pick the exit node (the tray) in
# operator.conf;
# more logging: `sudo systemctl edit toolnet` and add
#   [Service]
#   Environment=RUST_LOG=info,toolnet=debug
#
# Runs as root, but with every capability dropped except network admin
# (TUN, routes, nft, sysctl) and binding port 53 (MagicDNS). Root is what
# systemd-resolved expects for registering the MagicDNS domain.
[Unit]
Description=toolnet VPN (control plane on tool-db / Nostr)
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Environment=TOOLNET_STATE=/var/lib/toolnet
Environment=TOOLNET_ARGS=
Environment=TOOLNET_OPERATOR=
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/toolnet up $TOOLNET_ARGS
Restart=on-failure
RestartSec=5

StateDirectory=toolnet
StateDirectoryMode=0700
# The control socket, /run/toolnet/toolnet.sock (requests are checked by uid)
RuntimeDirectory=toolnet
RuntimeDirectoryMode=0755
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# /proc/sys/net/ipv4/{ip_forward,conf/*/rp_filter} for routes and exit nodes
ReadWritePaths=/proc/sys/net/ipv4

[Install]
WantedBy=multi-user.target
