# toolnet as a system service.
#
#   sudo install -m 755 target/release/toolnet /usr/local/bin/toolnet
#   sudo install -m 644 packaging/toolnet.service /etc/systemd/system/
#   sudo TOOLNET_STATE=/var/lib/toolnet toolnet init --owner npub1... --net home
#   sudo systemctl enable --now toolnet
#
# Extra flags (exit node, routes) go in a drop-in:
#   sudo systemctl edit toolnet
#   [Service]
#   Environment=TOOLNET_ARGS=--exit-node homelab
#
# Runs as root, but with every capability dropped except network admin
# (TUN, routes, nft, sysctl) and binding port 53 (MagicDNS). Root is what
# systemd-resolved expects for registering the MagicDNS domain.
[Unit]
Description=toolnet VPN (control plane on tool-db / Nostr)
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Environment=TOOLNET_STATE=/var/lib/toolnet
Environment=TOOLNET_ARGS=
ExecStart=/usr/local/bin/toolnet up $TOOLNET_ARGS
Restart=on-failure
RestartSec=5

StateDirectory=toolnet
StateDirectoryMode=0700
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# /proc/sys/net/ipv4/{ip_forward,conf/*/rp_filter} for routes and exit nodes
ReadWritePaths=/proc/sys/net/ipv4

[Install]
WantedBy=multi-user.target
