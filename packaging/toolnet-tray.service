# The toolnet tray icon, started with the desktop session. `toolnet install`
# puts it in /etc/systemd/user and enables it for every user (--global);
# opt out per user with `systemctl --user disable toolnet-tray`.
[Unit]
Description=toolnet tray icon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/toolnet-tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
